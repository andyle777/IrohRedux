{
  "name": "iroh",
  "version": "1.1.1",
  "description": "Watch JavaScript run \u2014 and change it mid-flight. Dynamic code analysis for JavaScript, with a CLI, Python and C++ clients.",
  "bin": {
    "iroh": "cli/iroh.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andyle777/IrohRedux.git"
  },
  "main": "dist/iroh-node.js",
  "module": "dist/iroh-node.es.mjs",
  "browser": "dist/iroh-browser.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./dist/iroh-browser.js",
      "import": "./dist/iroh-node.es.mjs",
      "require": "./dist/iroh-node.js"
    },
    "./cli": "./cli/iroh.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "iroh",
    "analysis",
    "dynamic",
    "runtime",
    "realtime",
    "debug",
    "visual",
    "python",
    "cpp",
    "cli"
  ],
  "homepage": "https://github.com/andyle777/IrohRedux",
  "author": "Felix Maier <xilefmai@gmail.com>",
  "contributors": [
    "Felix Maier <xilefmai@gmail.com> (https://github.com/maierfelix)"
  ],
  "bugs": {
    "url": "https://github.com/andyle777/IrohRedux/issues"
  },
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "dist": "npm run build && npm run browser",
    "build": "rollup -c rollup/rollup.config.cjs.js && rollup -c rollup/rollup.config.es.js",
    "browser": "rollup -c rollup/rollup.config.iife.js",
    "test": "node tests/index.js",
    "test:python": "python3 -m unittest discover -s python/tests -v",
    "test:cpp": "make -C cpp test",
    "test:types": "tsc --noEmit --strict --module esnext --moduleResolution bundler --target es2022 tests/types.ts",
    "codegen:irohscript": "npm run build && node scripts/compile-irohscript-core.mjs && npm run build",
 "check:dist": "node scripts/check-dist-drift.mjs"
  },
  "devDependencies": {
    "fast-check": "^4.10.3",
    "rollup": "^0.47.2",
    "rollup-plugin-buble": "^0.15.0",
    "rollup-plugin-commonjs": "^8.1.0",
    "rollup-plugin-json": "^2.3.0",
    "rollup-plugin-node-resolve": "^3.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "astring": "^1.9.0"
  }
}
