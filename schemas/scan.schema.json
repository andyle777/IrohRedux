{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andyle777/IrohRedux/blob/master/schemas/scan.schema.json",
  "title": "IrohRedux scan result",
  "description": "Compact scan document returned by the library or emitted by CLI --scan. Additional fields are allowed for forward compatibility.",
  "type": "object",
  "required": ["vectors", "findings", "scores", "summary"],
  "properties": {
    "type": { "const": "scan" },
    "vectors": {
      "type": "object",
      "required": ["features", "vector", "names"],
      "properties": {
        "features": {
          "type": "object",
          "required": ["calls", "depth", "repeat", "imbalance", "mix", "coverage", "events"],
          "properties": {
            "calls": { "type": "number" },
            "depth": { "type": "number" },
            "repeat": { "type": "number" },
            "imbalance": { "type": "number" },
            "mix": { "type": "number" },
            "coverage": { "type": "number" },
            "events": { "type": "number" }
          },
          "additionalProperties": true
        },
        "vector": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 6,
          "maxItems": 6
        },
        "names": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 6,
          "maxItems": 6
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message", "evidence", "neuron"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string" },
          "message": { "type": "string" },
          "evidence": { "type": "object" },
          "neuron": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "scores": {
      "type": "object",
      "required": ["coverage"],
      "properties": {
        "coverage": {
          "type": "object",
          "required": ["fired", "total", "value"],
          "properties": {
            "fired": { "type": "integer", "minimum": 0 },
            "reachable": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 },
            "value": { "type": "number" },
            "firedCategories": { "type": "array", "items": { "type": "string" } },
            "missingCategories": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["events", "findings", "warnings", "infos", "language", "findingsTruncated"],
      "properties": {
        "events": { "type": "integer", "minimum": 0 },
        "findings": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "infos": { "type": "integer", "minimum": 0 },
        "language": {
          "enum": ["javascript", "python", "cpp", "irohscript", "basic"]
        },
        "maxCallDepth": { "type": "integer", "minimum": 0 },
        "distinctRegions": { "type": "integer", "minimum": 0 },
        "findingsTruncated": { "type": "integer", "minimum": 0 },
        "unclosedFrames": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["count", "frames", "note"],
              "properties": {
                "count": { "type": "integer", "minimum": 0 },
                "frames": { "type": "array", "items": { "type": "string" } },
                "note": { "type": "string" }
              },
              "additionalProperties": true
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "events": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "additionalProperties": true
}
