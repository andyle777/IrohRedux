{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andyle777/IrohRedux/blob/master/schemas/translation.schema.json",
  "title": "IrohRedux translation result",
  "description": "CLI --translate result. A successful report means translation text was produced; inspect verify.ran separately to determine whether the generated program was executed.",
  "type": "object",
  "required": ["type", "from", "to", "code", "report"],
  "properties": {
    "type": { "const": "translation" },
    "from": {
      "enum": ["javascript", "python", "cpp", "irohscript", "basic"]
    },
    "to": {
      "enum": ["javascript", "python", "cpp", "irohscript", "basic"]
    },
    "code": { "type": "string" },
    "report": {
      "type": "object",
      "required": ["ok", "from", "to", "staticOnly", "clean", "assumptions", "unsupported", "notes", "verify"],
      "properties": {
        "ok": { "type": "boolean" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "staticOnly": { "type": "boolean" },
        "clean": { "type": "array" },
        "assumptions": { "type": "array" },
        "unsupported": { "type": "array" },
        "notes": { "type": "array" },
        "verify": {
          "type": "object",
          "required": ["attempted", "ran"],
          "properties": {
            "attempted": { "type": "boolean" },
            "ran": { "type": ["boolean", "null"] },
            "interpreter": { "type": "string" },
            "exit": { "type": ["integer", "null"] },
            "stderr": { "type": "string" },
            "reason": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
